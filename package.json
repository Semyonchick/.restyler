{
  "name": "restyler",
  "version": "2.0.0",
  "description": "Fast Vite-based asset builder for PHP and Bitrix projects",
  "private": true,
  "packageManager": "yarn@4.9.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "yarn dev",
    "dev": "vite",
    "watch": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "cert": "node scripts/create-local-certificate.js",
    "check": "vite build --emptyOutDir=false"
  },
  "browserslist": [
    "> 0.5%",
    "not dead",
    "not op_mini all"
  ],
  "keywords": [
    "vite",
    "bitrix",
    "php",
    "scss"
  ],
  "author": "Semyonchick",
  "license": "ISC",
  "devDependencies": {
    "sass": "^1.102.0",
    "svgo": "^4.0.2",
    "vite": "^8.2.1"
  }
}
